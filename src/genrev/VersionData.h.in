#pragma once

/*
 * Generated from VersionData.h.in by cmake/GenRevision.cmake, out of
 * cmake/Version.cmake plus the live git state. Every version number in this
 * tree originates here and nowhere else.
 *
 * DO NOT INCLUDE THIS HEADER. It carries the git hash, so it changes on every
 * commit and anything including it recompiles every time. Exactly two kinds of
 * file may: Version.cpp, which is the single translation unit that owns these
 * values and re-exports them as accessor functions, and the .rc files, because
 * the resource compiler needs literals and cannot call a function.
 *
 * Everything else includes Version.h.
 *
 * Plain macros only: the resource compiler parses this too.
 */

/* ---- product ---------------------------------------------------------- */
#define MANGOS_PACKAGENAME          "@MANGOS_PKG@"
#define MANGOS_VERSION_STR          "@MANGOS_VERSION@"
#define PROJECT_REVISION_NR         "@MANGOS_PKG@ @MANGOS_VERSION@"

/* ---- git -------------------------------------------------------------- */
#define REVISION_HASH               "@rev_hash@"
#define REVISION_DATE               "@rev_date@"
#define REVISION_BRANCH             "@rev_branch@"

/* ---- build host ------------------------------------------------------- */
#define MANGOS_BUILD_HOST           "@HOST_SYSTEM_NAME@ @HOST_SYSTEM_VERSION@"
#define MANGOS_BUILD_CMAKE          "@CMAKE_VERSION@"

/* ---- ready-made banner lines ------------------------------------------ */
#define MANGOS_FULL_REVISION        "Mangos revision: " VER_PRODUCTVERSION_STR
#define MANGOS_RUNNING_SYSTEM       "Running on: " MANGOS_BUILD_HOST

/* ---- database contract ------------------------------------------------ */
#define REALMD_DB_VERSION_NR        "@MANGOS_DB_REALMD_VERSION@"
#define REALMD_DB_STRUCTURE_NR      "@MANGOS_DB_REALMD_STRUCTURE@"
#define REALMD_DB_CONTENT_NR        "@MANGOS_DB_REALMD_CONTENT@"
#define REALMD_DB_UPDATE_DESCRIPT   "@MANGOS_DB_REALMD_DESCRIPT@"

#define CHAR_DB_VERSION_NR          "@MANGOS_DB_CHAR_VERSION@"
#define CHAR_DB_STRUCTURE_NR        "@MANGOS_DB_CHAR_STRUCTURE@"
#define CHAR_DB_CONTENT_NR          "@MANGOS_DB_CHAR_CONTENT@"
#define CHAR_DB_UPDATE_DESCRIPT     "@MANGOS_DB_CHAR_DESCRIPT@"

#define WORLD_DB_VERSION_NR         "@MANGOS_DB_WORLD_VERSION@"
#define WORLD_DB_STRUCTURE_NR       "@MANGOS_DB_WORLD_STRUCTURE@"
#define WORLD_DB_CONTENT_NR         "@MANGOS_DB_WORLD_CONTENT@"
#define WORLD_DB_UPDATE_DESCRIPT    "@MANGOS_DB_WORLD_DESCRIPT@"

/* ---- configuration files ---------------------------------------------- */
#define MANGOSD_CONFIG_VERSION      @MANGOS_WORLD_VER@
#define REALMD_CONFIG_VERSION       @MANGOS_REALM_VER@

#define SYSCONFDIR                  "@CONF_INSTALL_DIR@/"

#define MANGOSD_CONFIG_NAME         "mangosd.conf"
#define REALMD_CONFIG_NAME          "realmd.conf"

#define MANGOSD_CONFIG_LOCATION     SYSCONFDIR MANGOSD_CONFIG_NAME
#define REALMD_CONFIG_LOCATION      SYSCONFDIR REALMD_CONFIG_NAME

/* ---- windows VERSIONINFO ---------------------------------------------- */
#define VER_COMPANY_NAME_STR        "MaNGOS Developers"
#define VER_LEGALCOPYRIGHT_STR      "(c)2005-@rev_year@ MaNGOS"
#define VER_FILEVERSION             @MANGOS_VERSION_MAJOR@,@MANGOS_VERSION_MINOR@,@MANGOS_VERSION_PATCH@
#define VER_FILEVERSION_STR         "@MANGOS_VERSION@ (@rev_hash@ @rev_date@ @rev_branch@ branch)"
#define VER_PRODUCTVERSION          VER_FILEVERSION
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR
